# Nawah AI Core Configuration
PORT=3000
NODE_ENV=production

# Directory where SQLite database (nawah.db) and persisted master key live
NAWAH_DATA_DIR=./data

# Optional 64-char hex (32-byte) AES-256-GCM master key for encrypting provider & MCP secrets.
# If omitted, Nawah AI generates a secure 256-bit key and persists it inside NAWAH_DATA_DIR/.nawah_master_key.
NAWAH_MASTER_KEY=

# Optional initial global_admin access key for headless/CI deployments (e.g. nawah_admin_...).
# If omitted and zero keys exist in the database, the First-Run Setup UI will mint the first key.
NAWAH_BOOTSTRAP_ADMIN_KEY=
NAWAH_BOOTSTRAP_ADMIN_LABEL=Platform Admin

# Public URL where Nawah Core is reachable (used in generated integration recipes)
APP_URL=http://localhost:3000

# Upstream provider request and connection-test timeouts (milliseconds)
NAWAH_PROVIDER_TIMEOUT_MS=60000
NAWAH_PROVIDER_TEST_TIMEOUT_MS=10000
